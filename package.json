{
  "name": "modu-kindle-reading",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check worker/index.js && node scripts/validate-local.mjs && node --test \"tests/*.test.mjs\"",
    "build": "wrangler deploy --dry-run --outdir .tmp/cloudflare-build",
