    "cloudflare:deploy": "wrangler deploy"
  },
  "displayName": "墨读 · Kindle 家庭阅读与单词学习站",
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "netlify-cli": "^27.0.1",
    "wrangler": "^4.121.0"
  }
}
